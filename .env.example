# ── Build-time environment variables (Vite) ─────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git (it is in .gitignore).
# In Cloudflare Pages these are set via:
#   CF Pages dashboard → Settings → Environment Variables

# Google Maps Platform API key — enables Photorealistic 3D Tiles
# Where to get it:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project (or select existing)
#   3. "Create Credentials" → "API Key"
#   4. Enable "Map Tiles API" in the API Library
#   5. Restrict the key to your *.pages.dev domain in the key settings
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Cesium Ion access token — enables Cesium World Terrain (elevation)
# Where to get it:
#   1. Sign up (free) at https://ion.cesium.com/
#   2. Go to https://ion.cesium.com/tokens → "Create token"
#   3. Use default "My Sites" scope (allows terrain + base imagery)
VITE_CESIUM_TOKEN=your_cesium_ion_token_here

# ── Cloudflare Workers runtime secrets ───────────────────────────────────────
# These are NOT Vite variables — they run server-side in Workers.
# Set them with:  wrangler secret put SECRET_NAME
# They are NEVER embedded in the browser bundle.

# aisstream.io API key — enables live global AIS shipping data
# Where to get it:
#   1. Sign up (free) at https://aisstream.io/
#   2. Log in → click your avatar → "API Key"
#   3. Copy the key and run: wrangler secret put AISSTREAM_KEY
#
# Without this key the /api/shipping endpoint returns demo vessel data.
# AISSTREAM_KEY=your_aisstream_key_here

# OpenSky Network credentials — optional; increases anonymous rate limit
# Where to get them:
#   1. Register (free) at https://opensky-network.org/index.php?option=com_users&view=registration
#   2. Verify your email
#   3. Run: wrangler secret put OPENSKY_USERNAME
#           wrangler secret put OPENSKY_PASSWORD
#
# Without credentials: anonymous rate limit (1 req / 10 s, shared by Worker).
# With credentials:    10 req / 10 s per registered user.
# OPENSKY_USERNAME=your_opensky_username
# OPENSKY_PASSWORD=your_opensky_password

# ── Cloudflare Workers AI ────────────────────────────────────────────────────
# Workers AI requires NO API key — it is activated by the [ai] binding in
# wrangler.toml.  The free tier provides a daily "neurons" budget:
#   - @cf/meta/llama-3.1-8b-instruct: ~10,000 tokens/day on free tier
#   - Used by /api/agent (agentic orchestrator), /api/analyze,
#     /api/aircraft (emergency squawk enrichment),
#     /api/shipping (dark vessel detection)
#
# ── GitHub Actions secrets ───────────────────────────────────────────────────
# Add these in GitHub → Settings → Secrets and variables → Actions:
#
#   CF_API_TOKEN   — Cloudflare API token
#                    Create at https://dash.cloudflare.com/profile/api-tokens
#                    Use template "Edit Cloudflare Pages" or create custom with:
#                      Pages:Edit, Workers Scripts:Edit, D1:Edit, R2:Edit
#   CF_ACCOUNT_ID  — Your Cloudflare account ID
#                    Find at https://dash.cloudflare.com/ (right sidebar)
#   VITE_GOOGLE_MAPS_KEY  — same as above (for CI builds)
#   VITE_CESIUM_TOKEN     — same as above (for CI builds)

